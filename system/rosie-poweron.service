[Unit]
Description=Rosie's power-on sound (as soon as the speaker exists)
# No default dependencies, so it is not held back behind the network, time
# sync or the robot's own services: it only needs the root filesystem and udev.
DefaultDependencies=no
After=local-fs.target systemd-udevd.service
Conflicts=shutdown.target

[Service]
Type=simple
ExecStart=/usr/local/sbin/rosie-poweron
Nice=5

[Install]
WantedBy=multi-user.target
