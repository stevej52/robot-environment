[Unit]
Description=Rosie: the clock fallback - the last saved time at boot if the RTC battery is dead, saved every 10 min and at shutdown (also into rtc0)
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target time-set.target systemd-timesyncd.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/sbin/rosie-clock restore
ExecStop=/usr/local/sbin/rosie-clock save

[Install]
WantedBy=sysinit.target
