#!/bin/sh
# Rosie's last act: the "powering down" sound, played by systemd-shutdown after
# every service has stopped and the disks are unmounted or read-only, just
# before the power goes (Steve, 2026-09-26: "the absolute last thing it does").
#
# Installed by install_system_settings.sh to /usr/lib/systemd/system-shutdown/
# (systemd runs everything there with one argument: halt, poweroff, reboot or
# kexec). Only a real shutdown gets the sound - a reboot comes back with her
# hello. The wav is a copy under /usr, because /home may be gone by now, and
# the speaker is addressed by its ALSA card name, the same as sounds.py uses.
case "$1" in
    poweroff|halt) ;;
    *) exit 0 ;;
esac
WAV=/usr/local/share/rosie/shutdown.wav
[ -f "$WAV" ] || exit 0
timeout 6 /usr/bin/aplay -q -D plughw:CARD=UACDemoV10 "$WAV" 2>/dev/null \
    || timeout 6 /usr/bin/aplay -q "$WAV" 2>/dev/null
exit 0
