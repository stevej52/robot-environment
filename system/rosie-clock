#!/bin/sh
# Until 2026-09-30 Rosie had no RTC battery: a cold start booted the clock at 1970 (or systemd's
# build date) until Wi-Fi brought NTP. rosie-clock remembered the time instead (2026-09-28,
# Steve: "can you just have it change the date first thing when it boots up?"):
#   restore  at boot, before anything else: the last saved time, if it is later than now
#   save     every 10 min (rosie-clock-save.timer) and at shutdown: now, if later than saved,
#            and now into the battery-backed clock chip (rtc0) as well
# Since 2026-09-30 a CR2032 on the carrier board keeps rtc0 (nvvrs-pseq-rtc) running: the kernel
# sets the system clock from it 11 s into boot, later than any saved time, so restore does
# nothing and this is the fallback for a dead cell. rtc1 (tegra_rtc) is not on the battery.
F=/var/lib/rosie-clock
now=$(date -u +%s)
saved=$(cat "$F" 2>/dev/null || echo 0)
case "$1" in
    restore)
        if [ "$saved" -gt "$now" ]; then
            date -u -s "@$saved" > /dev/null && echo "rosie-clock: clock set to the last saved time, $(date)"
        fi ;;
    save)
        if [ "$now" -gt "$saved" ]; then
            echo "$now" > "$F.new" && mv "$F.new" "$F"
        fi
        [ -e /dev/rtc0 ] && hwclock -w -f /dev/rtc0 2>/dev/null ;;
    *)
        echo "usage: rosie-clock restore|save" >&2; exit 2 ;;
esac
